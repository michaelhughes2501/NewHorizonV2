# New Horizon — Environment Variables
# Copy this file to .env and fill in your values

# Port (default: 3000)
PORT=3000

# Database path (default: ./data/app.db)
# DB_PATH=./data/app.db

# Runtime mode. Leave this unset on a real deployment: `npm start` runs in
# production mode by default. `npm run dev` turns on development mode itself.
# NODE_ENV=production

# DEV ONLY. Returns password-reset tokens in the API response so the reset flow
# can be tested without an email provider. `npm run dev` already does this.
# Ignored in production mode. Never set this on a real deployment.
# EXPOSE_DEV_RESET_TOKEN=true

# How many proxy hops sit in front of the app (Render, Railway, Fly, Vercel = 1).
# Rate limits use the real visitor IP from X-Forwarded-For through these hops.
# Set to 0 only when the app is exposed directly with no proxy.
# TRUST_PROXY_HOPS=1

# How long a sign-in lasts before the user must sign in again (default: 14).
# SESSION_TTL_DAYS=14
